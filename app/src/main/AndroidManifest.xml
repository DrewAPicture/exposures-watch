<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".ExposuresApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          Phase 1 has no companion phone app yet, so the watch app is genuinely standalone right
          now. Revisit once phone-triggered capture (Phase 3) makes the watch meaningfully
          phone-dependent for its core value, even though roll/exposure logging keeps working
          offline either way.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Manifest-registered so the system can wake this up even when the app isn't running:
          DATA_CHANGED for the phone's equipment/roll/photo-status syncs, MESSAGE_RECEIVED for the
          capture-result ack.
        -->
        <service
            android:name=".sync.WearMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/equipment/camera-bodies" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/equipment/lenses" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/equipment/light-meters" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/equipment/film-backs" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/rolls" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/photo-status" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/command/capture-result" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/command/connectivity-ping-ack" />
            </intent-filter>
        </service>

        <!--
          Quick-logging Tile: shows the active roll's frame progress; tapping opens MainActivity
          straight into exposure entry for that roll (see ExposuresTileService/MainActivity).
        -->
        <service
            android:name=".tile.ExposuresTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>
    </application>
</manifest>
